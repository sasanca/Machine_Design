Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{"KtPlanoFlexionAgujero", "[", 
       StyleBox[
        RowBox[{"D", ",", "r"}],
        FontSlant->"Italic"], "]"}]], "InlineFormula"],
     " \[LineSeparator]Calcula el concentrador de tensiones de una placa \
plana con un agujero, al aplicarle un momento flector ",
     StyleBox["M",
      FontSlant->"Italic"],
     ". ",
     StyleBox["D",
      FontSlant->"Italic"],
     " es el ancho, ",
     StyleBox["r",
      FontSlant->"Italic"],
     " es el radio del orificio,  y ",
     StyleBox["t",
      FontSlant->"Italic"],
     " el espesor de la placa. \n\tLa tensi\[OAcute]n normal m\[AAcute]xima \
se calcula seg\[UAcute]n la f\[OAcute]rmula: ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox["\[Sigma]", "max"], "=", 
       RowBox[{
        SubscriptBox["K", "t"], 
        FractionBox[
         RowBox[{"12", "M", " ", "r"}], 
         RowBox[{"t", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["D", "3"], "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"2", "r"}], ")"}], "3"]}], ")"}]}]]}]}]], 
      "InlineFormula"],
     ".\[LineSeparator]",
     Cell[BoxData[
      GraphicsBox[
       TagBox[RasterBox[CompressedData["
