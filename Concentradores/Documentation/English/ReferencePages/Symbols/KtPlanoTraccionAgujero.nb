Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{"KtPlanoTraccionAgujero", "[", 
       RowBox[{"D", ",", "r"}], "]"}]], "InlineFormula"],
     " \[LineSeparator]Calcula el concentrador de tensiones de una placa \
plana con un agujero,  al aplicarle una fuerza axial P \
(tracci\[OAcute]n/compresi\[OAcute]n). D es el ancho, r es el radio del \
orificio,  y t el espesor de la placa. \[LineSeparator]\[LineSeparator]La \
tensi\[OAcute]n normal m\[AAcute]xima se calcula seg\[UAcute]n la \
f\[OAcute]rmula: ",
     Cell[BoxData[
      RowBox[{
       SubscriptBox["\[Sigma]", "max"], "=", 
       RowBox[{
        SubscriptBox["K", "t"], 
        FractionBox[
         RowBox[{"4", "P"}], 
         RowBox[{"t", 
          RowBox[{"(", 
           RowBox[{"D", "-", 
            RowBox[{"2", "r"}]}], ")"}]}]]}]}]], "InlineFormula"],
     ".\[LineSeparator]\[LineSeparator]",
     Cell[BoxData[
      RowBox[{"\t", 
