Cell[BoxData[GridBox[{
   {"", Cell[TextData[{
     Cell[BoxData[
      RowBox[{"Principales", "[", 
       RowBox[{
        SubscriptBox["\[Sigma]", "x"], ",", 
        SubscriptBox["\[Sigma]", "y"], ",", 
        SubscriptBox["\[Sigma]", "z"], ",", 
        SubscriptBox["\[Tau]", "xy"], ",", 
        SubscriptBox["\[Tau]", "xz"], ",", 
        SubscriptBox["\[Tau]", "yz"]}], "]"}]], "InlineFormula"],
     " \[LineSeparator]Calcula las tensiones principales de un estado \
tensional triaxial complejo a partir de las seis tensiones del espacio \
aplicando el proceso de diagonalizaci\[OAcute]n sobre el tensor de tensiones.\
\n\t Como resultado devuelve un vector con las tres tensiones principales del \
estado tensional dado.\n\t\n\t",
     Cell[BoxData[
      GraphicsBox[
       TagBox[RasterBox[CompressedData["
